#!/usr/bin/env python3
"""Print delegate runs per harness, model, effort, and Task map row, for the models.md review.

A run is a session, or a Claude Code subagent's log, whose last assistant reply
starts with a delegate status line; agy runs come from its JSONL transcripts under
~/.gemini/antigravity-cli/brain/. Launches are the `herdr agent start` calls in
Claude Code and Pi orchestrator transcripts, counted per harness kind, including
runs that never reported.
"""
import json
import re
import statistics
import sys
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path

STATUS_LINE = re.compile(r"^status:\s*(DONE|BLOCKED|FAILED)\b", re.MULTILINE)
TASK_LINE = re.compile(r"^task:\s*(.+)$", re.MULTILINE)
LAUNCH = re.compile(r"herdr agent start\s+\S+.*?--kind\s+(\w+)", re.S)


@dataclass(frozen=True)
class Run:
    harness: str
    model: str
    effort: str
    task: str
    status: str
    minutes: float
    tokens: int


def text_of(content) -> str:
    if isinstance(content, str):
        return content
    return "\n".join(block.get("text", "") for block in content if block.get("type") == "text")


def timestamp_seconds(value) -> float:
    if isinstance(value, (int, float)):
        return value / 1000
    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()


def run_from(harness: str, turns: list[dict]) -> Run | None:
    """turns: assistant turns in order, each with text, model, effort, tokens, time."""
    if not turns:
        return None
    report = turns[-1]["text"]
    status = STATUS_LINE.search(report)
    if not status:
        return None
    task = TASK_LINE.search(report)
    last = turns[-1]
    return Run(
        harness=harness,
        model=last["model"],
        effort=last["effort"] or "?",
        task=task.group(1).strip() if task else "?",
        status=status.group(1),
        minutes=(last["time"] - turns[0]["time"]) / 60,
        tokens=sum(turn["tokens"] for turn in turns),
    )


def claude_turns(records: list[dict], sidechain: bool = False) -> list[dict]:
    """sidechain: read a subagent log, whose records all carry isSidechain."""
    turns = []
    for record in records:
        if record.get("type") != "assistant" or bool(record.get("isSidechain")) != sidechain:
            continue
        message = record["message"]
        usage = message.get("usage") or {}
        turns.append({
            "text": text_of(message.get("content", [])),
            "model": message.get("model", "?"),
            "effort": record.get("effort"),
            "tokens": sum(usage.get(key, 0) for key in ("input_tokens", "cache_creation_input_tokens", "output_tokens")),
            "time": timestamp_seconds(record["timestamp"]),
        })
    return [turn for turn in turns if turn["text"]] or turns


def pi_turns(records: list[dict]) -> list[dict]:
    turns = []
    for record in records:
        message = record.get("message") or {}
        if message.get("role") != "assistant":
            continue
        usage = message.get("usage") or {}
        turns.append({
            "text": text_of(message.get("content", [])),
            "model": f"{message.get('provider', '?')}/{message.get('model', '?')}",
            "effort": message.get("thinkingLevel"),
            "tokens": usage.get("totalTokens", 0) - usage.get("cacheRead", 0),
            "time": timestamp_seconds(message.get("timestamp") or record["timestamp"]),
        })
    return [turn for turn in turns if turn["text"]] or turns


def agy_turns(records: list[dict]) -> list[dict]:
    """agy model IDs carry the effort as a suffix, such as gemini-4-carbon-medium."""
    turns = []
    for record in records:
        if record.get("type") != "PLANNER_RESPONSE":
            continue
        model = record.get("model", "?")
        base, _, suffix = model.rpartition("-")
        effort = suffix if suffix in ("low", "medium", "high", "xhigh") else None
        turns.append({
            "text": record.get("content") or "",
            "model": base if effort else model,
            "effort": effort,
            "tokens": record.get("input_tokens", 0) + record.get("output_tokens", 0),  # input excludes cache reads
            "time": timestamp_seconds(record["created_at"]),
        })
    return [turn for turn in turns if turn["text"]] or turns


def read_jsonl(path: Path) -> list[dict]:
    records = []
    bad_lines = 0
    for line in path.read_text(errors="replace").splitlines():
        try:
            records.append(json.loads(line))
        except json.JSONDecodeError:
            bad_lines += 1
    if bad_lines:
        print(f"skip {bad_lines} unparsable lines in {path}", file=sys.stderr)
    return records


def collect(home: Path) -> list[Run]:
    runs = []
    sources = [
        ("claude", sorted(home.glob(".claude/projects/*/*.jsonl")), claude_turns),
        ("claude subagent", sorted(home.glob(".claude/projects/*/*/subagents/*.jsonl")),
         lambda records: claude_turns(records, sidechain=True)),
        ("pi", sorted(home.glob(".pi/agent/sessions/*/*.jsonl")), pi_turns),
        ("agy", sorted(home.glob(".gemini/antigravity-cli/brain/*/.system_generated/logs/transcript_full.jsonl")), agy_turns),
    ]
    for harness, paths, turns_of in sources:
        for path in paths:
            run = run_from(harness, turns_of(read_jsonl(path)))
            if run:
                runs.append(run)
    return runs


def summarize(runs: list[Run]) -> list[tuple]:
    groups: dict[tuple, list[Run]] = {}
    for run in runs:
        groups.setdefault((run.harness, run.model, run.effort, run.task), []).append(run)
    rows = []
    for key, group in sorted(groups.items()):
        done = [run for run in group if run.status == "DONE"]
        rows.append((
            *key,
            len(group),
            f"{len(done) / len(group):.0%}",
            f"{statistics.median(run.minutes for run in group):.1f}",
            sum(run.tokens for run in group) // len(done) if done else "-",
        ))
    return rows


def launches(home: Path) -> dict[str, int]:
    """Count `herdr agent start` calls per --kind in shell commands the orchestrators ran."""
    counts: dict[str, int] = {}
    paths = sorted(home.glob(".claude/projects/*/*.jsonl")) + sorted(home.glob(".pi/agent/sessions/*/*.jsonl"))
    for path in paths:
        for record in read_jsonl(path):
            content = (record.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for part in content:
                if not isinstance(part, dict):
                    continue
                args = part.get("input") if part.get("type") == "tool_use" else part.get("arguments") if part.get("type") == "toolCall" else None
                command = args.get("command") if isinstance(args, dict) else None
                if isinstance(command, str):
                    for match in LAUNCH.finditer(command):
                        counts[match.group(1)] = counts.get(match.group(1), 0) + 1
    return counts


def main() -> None:
    runs = collect(Path.home())
    header = ("harness", "model", "effort", "task", "runs", "done", "median_min", "tokens_per_done")
    print("\t".join(header))
    for row in summarize(runs):
        print("\t".join(str(value) for value in row))
    print("\nkind\tlaunches")
    for kind, count in sorted(launches(Path.home()).items(), key=lambda item: -item[1]):
        print(f"{kind}\t{count}")


if __name__ == "__main__":
    main()
